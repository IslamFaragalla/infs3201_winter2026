<h1>Add Employee</h1>

<form method="POST" action="/employee/add">
  <div>
    <label>Name:</label>
    <input type="text" name="name">
  </div>

  <div>
    <label>Phone:</label>
    <input type="text" name="phone" placeholder="dddd-dddd">
  </div>

  <button type="submit">Save</button>
</form>

<p><a href="/">Cancel</a></p>