<h1>Employee Details</h1>

<p><strong>ID:</strong> {{employee.employeeId}}</p>
<p><strong>Name:</strong> {{employee.name}}</p>
<p><strong>Phone:</strong> {{employee.phone}}</p>

<p>
  <a href="/employee/{{employee.employeeId}}/edit">Edit Details</a>
</p>

<h2>Shifts</h2>

<table border="1" cellpadding="5">
  <tr>
    <th>Date</th>
    <th>Start</th>
    <th>End</th>
  </tr>

  {{#each shifts}}
    <tr>
      <td>{{this.date}}</td>
      <td class="{{morningClass this.startTime}}">
        {{this.startTime}}
      </td>
      <td>{{this.endTime}}</td>
    </tr>
  {{/each}}
</table>

<p><a href="/">Back</a></p>