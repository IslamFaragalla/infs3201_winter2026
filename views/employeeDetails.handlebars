<h1>Employee Details</h1>

<p><b>ID:</b> {{employee._id}}</p>
<p><b>Name:</b> {{employee.name}}</p>
<p><b>Phone:</b> {{employee.phone}}</p>

<a href="/editEmployee/{{employee._id}}">Edit Details</a>

<h2>Shifts</h2>

<table border="1">
  <tr>
    <th>Date</th>
    <th>Start</th>
    <th>End</th>
  </tr>

  {{#each shifts}}
  <tr>
    <td>{{date}}</td>
    <td>{{startTime}}</td>
    <td>{{endTime}}</td>
  </tr>
  {{/each}}
</table>

<br>
<a href="/">Back</a>